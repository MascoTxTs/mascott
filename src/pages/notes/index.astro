---
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";

const notes = await getCollection("notes");

notes.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Notes — Mascott</title>

    <link rel="icon" type="image/svg+xml" href={`${base}cat.svg`} />
  </head>

  <body>
    <main class="notes-page">
      <a href={base}>← Back to home</a>

      <header>
        <p>NOTES</p>
        <h1>Things worth recording.</h1>
        <p>
          A growing archive of ideas, questions, and things I learn.
        </p>
      </header>

      <section>
        {
          notes.map((note) => (
            <article>
              <time>
                {note.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </time>

              <h2>
                <a href={`${base}notes/${note.id}/`}>
                  {note.data.title}
                </a>
              </h2>

              <p>{note.data.description}</p>

              <div>
                {note.data.tags.map((tag) => (
                  <span>#{tag}</span>
                ))}
              </div>
            </article>
          ))
        }
      </section>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    background: #f3f3f1;
    color: #171717;
    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .notes-page {
    width: min(900px, calc(100% - 48px));
    margin: 0 auto;
    padding: 64px 0 100px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  header {
    margin: 90px 0 70px;
  }

  header p:first-child {
    font-size: 12px;
    letter-spacing: 0.16em;
  }

  h1 {
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.05;
    margin: 20px 0;
  }

  header p:last-child {
    color: #666;
    font-family: Georgia, serif;
    font-size: 18px;
  }

  article {
    border-top: 1px solid #d2d2cf;
    padding: 28px 0 32px;
  }

  time {
    font-size: 12px;
    color: #777;
  }

  h2 {
    font-size: 24px;
    font-weight: 500;
    margin: 10px 0;
  }

  article p {
    color: #666;
    font-size: 14px;
    line-height: 1.7;
    max-width: 650px;
  }

  article span {
    margin-right: 12px;
    font-size: 12px;
    color: #315e8c;
  }

  @media (max-width: 760px) {
    .notes-page {
      width: min(100% - 32px, 900px);
      padding-top: 32px;
    }

    header {
      margin: 70px 0 50px;
    }
  }
</style>