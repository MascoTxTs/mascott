---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";

const title = "反馈 — Mascott";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>

    <meta
      name="description"
      content="为 Mascott 的个人研究档案提供反馈。"
    />

    <link rel="icon" type="image/svg+xml" href={`${base}cat.svg`} />
  </head>

  <body>
    <main class="feedback-page">

      <!-- Feedback form state -->
      <section id="feedback-form-section">

        <a class="back" href={`${base}zh/`}>
          ← 返回首页
        </a>

        <header>
          <p class="eyebrow">反馈</p>

          <h1>
            有什么可以改进？
          </h1>

          <p class="intro">
            这个网站会持续记录我的大学四年。
            如果你发现不清楚的内容、失效的功能，或有其他建议，
            欢迎告诉我。
          </p>
        </header>

        <form id="feedback-form">

          <label>
            昵称
            <input
              type="text"
              name="nickname"
              placeholder="选填"
            />
          </label>

          <label>
            页面或板块
            <select name="section">
              <option value="">请选择</option>
              <option value="home">首页</option>
              <option value="research">研究</option>
              <option value="projects">项目</option>
              <option value="notes">笔记</option>
              <option value="other">其他</option>
            </select>
          </label>

          
          <label>
            设备 / 平台
            <select name="device">
              <option value="">请选择设备</option>
              <option value="Mac">Mac</option>
              <option value="Windows">Windows</option>
              <option value="iPhone">iPhone</option>
              <option value="iPad">iPad</option>
              <option value="Android">Android</option>
              <option value="Linux">Linux</option>
              <option value="Other">其他</option>
            </select>
          </label>


          <label>
            反馈
            <textarea
              name="message"
              rows="7"
              maxlength="1000"
              placeholder="请描述具体位置、遇到的问题或你的建议。"
              required
            ></textarea>
            <span id="message-counter">0 / 1000</span>
          </label>

          <button type="submit" id="submit-button">
            发送反馈
          </button>

        </form>

        <p class="note">
          你的意见会帮助我改进这个网站。
        </p>

      </section>


      <!-- Success state -->
      <section
        id="feedback-success"
        class="feedback-success"
        hidden
      >

        <p class="eyebrow">反馈</p>

        <div class="success-symbol">✓</div>

        <h1>
          已收到反馈。
        </h1>

        <p class="success-message">
          谢谢你花时间帮助我改进网站。
        </p>

        <div class="success-actions">

          <a href={`${base}zh/`} class="success-back">
            ← 返回首页
          </a>

          <button
            type="button"
            id="write-again"
            class="write-again"
          >
            再写一条 →
          </button>

        </div>

      </section>

    </main>
  </body>
</html>


<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f2f2f0;
    color: #181818;
    font-family: Arial, Helvetica, sans-serif;
  }

  .feedback-page {
    width: min(720px, calc(100% - 3rem));
    margin: 0 auto;
    padding: 4rem 0 6rem;
  }

  .back {
    color: #666;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back:hover {
    color: #315E8C;
  }

  header {
    margin-top: 6rem;
    margin-bottom: 3rem;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #315E8C;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 400;
    line-height: 1.15;
  }

  .intro {
    max-width: 580px;
    margin-top: 1.5rem;
    color: #666;
    line-height: 1.8;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    color: #333;
    font-size: 0.9rem;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid #d2d2cf;
    border-radius: 0;
    background: #fafaf8;
    padding: 0.85rem;
    color: #181818;
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: #315E8C;
  }

  button {
    width: fit-content;
    border: 1px solid #181818;
    background: #181818;
    color: white;
    padding: 0.8rem 1.4rem;
    cursor: pointer;
    font: inherit;
  }

  button:hover {
    background: #315E8C;
    border-color: #315E8C;
  }

  button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .note {
    margin-top: 2rem;
    color: #888;
    font-size: 0.8rem;
  }


  /* Success state */

  .feedback-success {
    padding-top: 8rem;
  }

  .success-symbol {
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: #315E8C;
    font-size: 1.2rem;
  }

  .feedback-success h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
  }

  .success-message {
    max-width: 580px;
    margin-top: 1.5rem;
    color: #666;
    line-height: 1.8;
  }

  .success-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .success-back,
  .write-again {
    color: #315E8C;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .write-again {
    border: 0;
    background: none;
    padding: 0;
    color: #315E8C;
    font: inherit;
    cursor: pointer;
  }

  .write-again:hover {
    border: 0;
    background: none;
    color: #181818;
  }


  @media (max-width: 760px) {

    .feedback-page {
      width: min(100% - 2rem, 720px);
      padding-top: 2rem;
    }

    header {
      margin-top: 4rem;
    }

    .feedback-success {
      padding-top: 5rem;
    }

    .success-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>


<script>
  import { supabase } from "../../lib/supabase";

  const formSection = document.querySelector("#feedback-form-section");
  const form = document.querySelector("#feedback-form");
  const success = document.querySelector("#feedback-success");
  const button = document.querySelector("#submit-button");
  const writeAgain = document.querySelector("#write-again");

  const messageInput = document.querySelector(
  'textarea[name="message"]'
);
const messageCounter = document.querySelector("#message-counter");

messageInput?.addEventListener("input", () => {
  if (messageCounter && messageInput) {
    messageCounter.textContent =
      `${messageInput.value.length} / 1000`;
  }
});

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const formData = new FormData(form);

    const nickname = String(
      formData.get("nickname") || ""
    ).trim();

    const section = String(
      formData.get("section") || ""
    ).trim();

    const device = String(
      formData.get("device") || ""
    ).trim();

    const message = String(
      formData.get("message") || ""
    ).trim();

    if (!message) {
      return;
    }

    if (message.length > 1000) {
      alert("反馈内容不能超过 1000 个字符。");
      return;
    }

    if (button) {
      button.disabled = true;
      button.textContent = "发送中……";
    }

    const { error } = await supabase
      .from("feedback")
      .insert([
        {
          nickname,
          section,
          device,
          message,
        },
      ]);

    if (error) {
      console.error(error);

      if (button) {
        button.disabled = false;
        button.textContent = "发送反馈";
      }

      alert("发送失败，请稍后重试。你填写的内容已保留。");
      return;
    }

    // Hide the entire form.
    if (formSection) {
      formSection.hidden = true;
    }

    // Show the success state.
    if (success) {
      success.hidden = false;
    }
  });


  // Write another feedback.
  writeAgain?.addEventListener("click", () => {

    form?.reset();

    if (messageCounter) {

      messageCounter.textContent = "0 / 1000";

    } 

    if (button) {
      button.disabled = false;
      button.textContent = "发送反馈";
    }

    if (success) {
      success.hidden = true;
    }

    if (formSection) {
      formSection.hidden = false;
    }

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  });
</script>