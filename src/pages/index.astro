            </p >
          </div>

          <div class="contact-links">

            <a href="mailto:mascotxt@outlook.com">
              Email ↗
            </a >

            <a
              href="https://github.com/MascoTxTs"
              target="_blank"
              rel="noreferrer"
            >
              GitHub ↗
            </a >

          </div>

        </div>

      </section>

        <section class="feedback-section">

          <div class="feedback-line">
            <span>Have a suggestion?</span>

            <a href="/feedback">
