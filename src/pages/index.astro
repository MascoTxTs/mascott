---
import { getCollection } from "astro:content";

const research = [
  {
    symbol: "⌁",
    title: "Brain-Computer Interfaces",
    description:
      "Neural signals, brain–computer interaction, computational approaches",
  },
  {
    symbol: "λ",
    title: "Computer Science",
    description:
      "Algorithms, systems, programming, artificial intelligence",
  },
  {
    symbol: "∑",
    title: "Mathematics",
    description:
      "Structures, abstraction, reasoning, mathematical foundations",
  },
  {
    symbol: "◌",
    title: "Psychology",
    description:
      "Mind, cognition, behavior, human intelligence",
  },
];

const notes = await getCollection("notes");

notes.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

console.log("HOME NOTES:", notes);
---
<!doctype html>

<html lang="en">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width"
  />

  <meta
    name="description"
    content="Mascott — Computer Science student and personal research archive."
  />

  <title>Mascott — Computer Science</title>

  <link
    rel="icon"
    type="image/svg+xml"
    href="/cat.svg"
  />
</head>

<body>
  <main class="page">

    <!-- LEFT -->

    <aside class="sidebar">

      <div class="identity">
        <div class="portrait">M</div>

        <div>
          <h1>彭子懿</h1>
          <p class="name-en">Mascott</p >
        </div>
      </div>

      <div class="bio">
        <p>Computer Science</p >
        <p>Tianjin University × PolyU</p >
        <p>Shenzhen</p >
        <p>First-year student</p >
      </div>

      <div class="sidebar-divider"></div>

      <nav class="nav">
        <a href=" ">Research</a >
        <a href="#projects">Projects</a >
        <a href="#notes">Notes</a >
        <a href="#archive">Archive</a >
      </nav>

      <div class="sidebar-divider"></div>

      <div class="links">
        <a
          href="https://github.com/MascoTxTs"
          target="_blank"
          rel="noreferrer"
        >
          GitHub ↗
        </a >

        <a href="mailto:mascotxt@outlook.com">
          Email ↗
        </a >
      </div>

      <div class="side-mark">M/</div>

    </aside>


    <!-- RIGHT -->

    <section class="content">

      <!-- INTRO -->

      <header class="intro">
        <div class="section-mark">§</div>

        <div>
          <p class="eyebrow">PERSONAL RESEARCH ARCHIVE</p >

          <h2>
            Questions worth exploring.<br />
            Things worth building.
          </h2>

          <p class="intro-text">
            A growing archive of research interests, experiments,
            notes, and things I build along the way.
          </p >
        </div>
      </header>


      <!-- RESEARCH -->

      <section id="research" class="section">

        <div class="section-heading">
          <span>01</span>
          <h3>Research</h3>
        </div>

        <div class="research-list">

          {research.map((item) => (

            <article class="research-item">

              <div class="research-symbol">
                {item.symbol}
              </div>

              <div class="research-main">
                <h4>{item.title}</h4>
                <p>{item.description}</p >
              </div>

              <div class="research-arrow">
                ↗
              </div>

            </article>

          ))}

        </div>

      </section>


      <!-- PROJECTS / ACTIVITY -->

      <section id="projects" class="section">

        <div class="section-heading">
          <span>02</span>
          <h3>Projects / Activity</h3>
        </div>

        <div class="activity">

          <div class="activity-year">
            2026
          </div>

          <article class="activity-item">

            <div class="activity-date">
              <span>Oct</span>
              <strong>05</strong>
            </div>

            <div class="activity-line">
              <span></span>
            </div>

            <div class="activity-body">

              <div class="activity-top">

                <div>
                  <p class="activity-type">Research</p >

                  <h4>
                    Started exploring
                    <span>Brain-Computer Interfaces</span>
                  </h4>
                </div>

                <div class="activity-icon">
                  ⌁
                </div>

              </div>

              <p class="activity-description">
                Beginning to investigate neural signals,
                EEG, computational models, and the relationship
                between biological and artificial intelligence.
              </p >

              <div class="activity-links">
                <a href="#notes">Notes ↗</a >
                <span>·</span>
                <a href="#research">Research ↗</a >
              </div>

            </div>

          </article>


          <article class="activity-item placeholder">

            <div class="activity-date">
              <span>soon</span>
            </div>

            <div class="activity-line">
              <span></span>
            </div>

            <div class="activity-body">

              <div class="activity-top">

                <div>
                  <p class="activity-type">Project</p >

                  <h4>
                    Nothing here yet.
                  </h4>
                </div>

                <div class="activity-icon muted">
                  +
                </div>

              </div>

              <p class="activity-description">
                This section will gradually become a record
                of things I actually build, investigate, and publish.
              </p >

            </div>

          </article>

        </div>

      </section>


      <!-- NOTES -->

      <section id="notes" class="section">

        <div class="section-heading">
          <span>03</span>
          <h3>Notes</h3>
        </div>

        <div class="notes-list">

          {notes.slice(0, 4).map((note) => (

            <a
              href={`/notes/${note.id}/`}
              class="note-item"
            >

              <div class="note-date">
                {note.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "2-digit",
                  day: "2-digit",
                })}
              </div>

              <div class="note-content">

                <h4>{note.data.title}</h4>

                <p>{note.data.description}</p >

              </div>

              <span class="note-arrow">
                ↗
              </span>

            </a >

          ))}

        </div>

        <p class="notes-foot">
          Written irregularly. Mostly questions, ideas,
          observations, and things worth remembering.
        </p >

      </section>


      <!-- ARCHIVE -->

      <section
        id="archive"
        class="section archive-section"
      >

        <div class="section-heading">
          <span>04</span>
          <h3>Archive</h3>
        </div>

        <div class="archive-box">

          <div class="archive-symbol">
            ∞
          </div>

          <div>
            <h4>A record of four years.</h4>

            <p>
              Research directions will change.
              Projects will accumulate.
              Notes will become connections.
              This page is meant to grow with them.
            </p >
          </div>

        </div>

      </section>


      <!-- CONTACT -->

      <section
        id="contact"
        class="section contact-section"
      >

        <div class="section-heading">
          <span>05</span>
          <h3>Contact</h3>
        </div>

        <div class="contact-grid">

          <div>
            <p class="contact-intro">
