          </div>

        </section>

        <!-- FOOTER -->

        <footer>

          <div>

            <span class="footer-mark">M/</span>

            <span>Mascott</span>

          </div>

          <div>

            Shenzhen · 2026

          </div>

        </footer>

      </section>

    </main>

  </body>

</html>

